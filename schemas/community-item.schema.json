{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lull-community.invalid/schemas/community-item.schema.json",
  "title": "Lull Community Item",
  "description": "本仓库自有的展示元数据。只被网站读取，不会进入内容包，Lull 桌面端也不认识它。作品的名称/版本/作者/许可一律以包内清单为准，不在这里重复。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "addedAt", "tags"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,31}$",
      "description": "必须与所在目录名一致；同时作为网站 URL 段。"
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 16 }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "是否在作品列表中标记为精选；维护者合并时决定。"
    },
    "addedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "首次合并日期，用于「最新」排序。"
    },
    "preview": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(?:webp|png|jpg|jpeg|avif)$",
      "default": "preview.webp",
      "description": "作品目录内的预览图文件名，建议 16:9。"
    },
    "screenshots": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(?:webp|png|jpg|jpeg|avif)$"
      }
    },
    "authorUrl": {
      "type": "string",
      "pattern": "^https://",
      "description": "作者主页或仓库地址，可选。"
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://",
      "description": "作品自身的介绍页，可选。"
    },
    "note": {
      "type": "string",
      "maxLength": 280,
      "description": "维护者备注，不展示在公开页面上。"
    }
  }
}
