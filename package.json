{
  "name": "lull-community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "content:check": "node scripts/validate-content.mjs",
    "content:hash": "node scripts/validate-content.mjs --fix",
    "content:pack": "node scripts/package-content.mjs",
    "commit:check": "node scripts/check-commit.mjs --range origin/main..HEAD",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:site": "pnpm --dir site build",
    "build": "pnpm content:check && pnpm build:catalog && pnpm build:site",
    "dev": "pnpm build:catalog && pnpm --dir site dev",
    "new": "node scripts/new-item.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "sign:release": "node scripts/sign-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "trust:host": "node scripts/export-host-trust.mjs",
    "check:issue": "node scripts/ci/check-issue.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1"
  }
}
