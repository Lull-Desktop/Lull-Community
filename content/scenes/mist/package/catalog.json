{
  "schemaVersion": 1,
  "scenes": [
    {
      "schemaVersion": 1,
      "type": "scene",
      "id": "community.mist",
      "name": "雾岚",
      "version": "1.1.0",
      "description": "层叠青山与湖面笼在缓缓流动的薄雾中，鼠标移动带来柔和的雾光。",
      "author": "Lull Community",
      "license": "CC-BY-4.0",
      "capabilities": [
        "wallpaper.viewport",
        "wallpaper.canvas",
        "wallpaper.params",
        "wallpaper.script",
        "wallpaper.pointer"
      ],
      "entry": "scenes/mist/index.html",
      "theme": {
        "background": "#0a1416",
        "accent": "#9fc7c2"
      },
      "performance": {
        "tier": "low",
        "targetFps": 30
      },
      "compatibility": {
        "hostApi": 3,
        "platforms": [
          "windows"
        ]
      },
      "integrity": {
        "algorithm": "sha256",
        "scope": "package",
        "digest": "40f1ab1ab2bb439a9321333e88f0f8adc44c1491b076bcff0644cc114f574c81"
      },
      "params": [
        {
          "key": "intensity",
          "type": "number",
          "label": "氛围强度",
          "description": "雾气的浓淡。",
          "default": 1,
          "min": 0.2,
          "max": 1.4,
          "step": 0.1
        },
        {
          "key": "interactive",
          "type": "boolean",
          "label": "鼠标响应",
          "description": "关闭后仍保留自动动画；鼠标点击始终穿透桌面。",
          "default": true
        }
      ]
    }
  ]
}
