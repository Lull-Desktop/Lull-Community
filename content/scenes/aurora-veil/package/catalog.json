      "type": "scene",
      "id": "community.aurora-veil",
      "name": "极光帷幕",
      "version": "1.1.0",
      "description": "星光与极光在雪山湖泊上流动，鼠标移动时微光轻轻追随。",
      "author": "Lull Community",
      "license": "CC-BY-4.0",
      "capabilities": [
        "wallpaper.viewport",
        "wallpaper.canvas",
        "wallpaper.params",
        "wallpaper.script",
        "wallpaper.pointer"
      ],
      "entry": "scenes/aurora-veil/index.html",
      "theme": {
        "background": "#04060e",
        "accent": "#48d6b2"
      },
      "performance": {
        "tier": "low",
        "targetFps": 30
      },
      "compatibility": {
        "hostApi": 3,
        "platforms": [
          "windows"
        ]
      },
      "integrity": {
        "algorithm": "sha256",
        "scope": "package",
        "digest": "c1bb2714e95f9eda63583b9bb0a3b92e540f4235cc4bfbc41132a72bbb2cc09e"
      },
      "params": [
        {
          "key": "intensity",
          "type": "number",
