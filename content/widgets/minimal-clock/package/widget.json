  "author": "Lull Community",
  "license": "MIT",
  "builtin": false,
  "hostApi": 1,
  "entry": "index.html",
  "lifecycle": "background",
  "capabilities": ["widget.ui"],
  "window": {
    "width": 480,
    "height": 300,
    "minWidth": 480,
    "minHeight": 300,
    "resizable": false,
    "transparent": true,
    "chrome": "host"
  },
  "network": []
}
